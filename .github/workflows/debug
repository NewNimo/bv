name: Alpha Build

on:
  push:
    branches:
      - develop

jobs:
  build-alpha:
    name: Build Alpha Apk
    runs-on: ubuntu-latest
    # 移除仓库限制，或改为你的仓库名
    # if: github.repository == '你的用户名/仓库名'

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          ref: develop
          fetch-depth: 0
          submodules: 'true'

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Setup Gradle to generate and submit dependency graphs
        uses: gradle/actions/setup-gradle@v3
        with:
          dependency-graph: generate-and-submit

      # 如果项目不需要Google服务，可以注释掉这部分
      # - name: Write google-services.json
      #   env:
      #     DATA: ${{ secrets.GOOGLE_SERVICES_JSON }}
      #   run: echo $DATA > app/google-services.json

      - name: Grant execute permission for gradlew
        run: chmod +x gradlew

      # 移除签名相关步骤，直接构建debug版本
      - name: Build debug apk
        run: ./gradlew assembleDebug

      - name: Read debug apk output metadata
        id: apk-meta-debug
        uses: juliangruber/read-file-action@v1
        with:
          path: app/build/outputs/apk/debug/output-metadata.json

      - name: Parse apk infos
        id: apk-infos
        run: |
          echo "debug_info_version_code=${{ fromJson(steps.apk-meta-debug.outputs.content).elements[0].versionCode }}" >> $GITHUB_ENV
          echo "debug_info_version_name=${{ fromJson(steps.apk-meta-debug.outputs.content).elements[0].versionName }}" >> $GITHUB_ENV

      - name: Determine tag name
        id: tag_name
        run: echo "tag_name=debug-r${{ env.debug_info_version_code }}" >> $GITHUB_ENV

      - name: Get changelog
        id: changelog
        run: |
          {
            echo "changelog<<EOF"
            echo "$(git log --pretty=format:"- %s (%h)" ${{ github.event.before }}..${{ github.sha }})"
            echo "EOF"
          } >> "$GITHUB_ENV"

      # 上传构建产物
      - name: Archive debug build artifacts
        uses: actions/upload-artifact@v4
        with:
          name: Debug build artifact
          path: app/build/outputs/apk/debug/*.apk

      # 发布到GitHub Release
      - name: Publish Pre-Release
        uses: softprops/action-gh-release@v2
        with:
          files: app/build/outputs/apk/debug/*.apk
          tag_name: ${{ env.tag_name }}
          name: Debug ${{ env.debug_info_version_name }}
          prerelease: true
          body: ${{ env.changelog }}
          target_commitish: ${{ github.sha }}
